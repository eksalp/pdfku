  <object class="GtkSizeGroup" id="sizegroup1">
    <property name="mode">vertical</property>
    <widgets>
      <widget name="fonts"/>
      <widget name="fontsSubsetLB"/>
      <widget name="symbols"/>
      <widget name="symbolSets"/>
      <widget name="styles"/>
    </widgets>
  </object>
</interface>
